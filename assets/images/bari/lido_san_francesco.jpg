    background: #119d34 !important;
}



.textwidget a {
  background:none!important;
}

.vlt-post-title.h5 {
  background:
#ce0000;
  display: inline;
padding:2px;
}


header .vlt-social-icon.vlt-social-icon--style-1 {
  font-size: 18px;
	margin-top:18px
}


.vlt-social-icon.vlt-social-icon--style-1 {
  font-size: 24px;
}

.vlt-nav--fullscreen__navigation ul.sf-menu li.current-menu-ancestor > a {color:black;}


.vlt-footer {

    background-color:transparent!important;
}


#mapModalClose {
  cursor: pointer !important;
}

#my-agile-privacy-consent-again {
  background: black;
}

#my-agile-privacy-consent-again a {
  color: white;
}


.textwidget a {
  background: #119d34;
  padding: 15px;
  border-radius: 35px;
  color: white;
  font-weight: bold;
}


.textwidget strong {
  font-weight: bold;
}


.gallery-item {
  margin-top: 20px !important;
}

.vlt-post-date {
  display: none;
}


/* BANNER COOKIE */
.map_notification_container a {
  font-weight: bold;
}


/* LINGUISE */


#linguise_background {
  background: hsl(0deg 0% 10.24% / 28%) !important;
}

#linguise_popup .linguise_lang_name {
  color: #a5a5a5 !important;
}

#menu-menu-versione-mobile span.linguise_lang_name {font-size:19px!important;} 

