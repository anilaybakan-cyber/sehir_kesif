	text-align:center;
}


/*SCROLL TEXT CSS */


 .containerAnimation { 

      position: relative;
      height: clamp(3em, 10vw, 7em);
      overflow: hidden;         

  }

   .marquee-text {
       
      position: absolute;
      font-size: clamp(2.5rem, 8vw, 5.5rem);
      font-family: sans-serif;
      text-transform: uppercase;
      font-weight: 700;
        
   } 



    .marquee-text {            
            animation: marquee 300s infinite linear;        
       }
    

    @keyframes marquee {

          0% {
             left: 100%;
          }
        
          100% {
             left: 0;
             transform: translateX(-100%);
          }

       }


