  opacity: 1;
}

span.linguise_lang_name {
  color:#fff!important;
}


/* modifica barra menu per new header */

.vlt-navbar-logo.vlt-navbar-logo--small {
  margin-top: -5px;
}

.vlt-navbar.vlt-navbar--main.vlt-navbar--sticky.vlt-navbar--colored.vlt-navbar--fixed .vlt-nav--default .sf-menu > li {
  margin-top: 4px;
}


a.vlt-navbar-logo {
    margin-top: 7px;
}

.vlt-nav--default .sf-menu > li {
  min-height: 80%;
}



.vlt-header--default-center .vlt-navbar-outer {
  min-height: calc(var(--vlt-navbar-height) + 0.5rem)!important;
}


.vlt-header--default-center .vlt-navbar-inner {
  box-shadow: none;
}


/* fine modifiche barra menu*/



#menu-menu-versione-mobile .sub-menu {background:#c11616!important;
border-radius:16px;
}

#menu-menu-versione-mobile .sub-menu a:hover {
    color: #c7b14f !important;
}

.vlt-nav--fullscreen__navigation ul.sf-menu li:hover>a {
    color:black;
}


nav.vlt-nav.vlt-nav--fullscreen.is-open {
    background: #df2828;
    color: white;
}


.vlt-single-post-content h5 {
  color: #d70000 !important;
  margin-top: 20px;
}


.elementor-accordion-title {
  color: black !important;
}

