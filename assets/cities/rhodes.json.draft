    {
      "id": "ChIJlajohelhlRQRN1CCGpS6omg",
      "name": "Palace of the Grand Master of the Knights of Rhodes",
      "name_en": "Palace of the Grand Master of the Knights of Rhodes",
      "category": "Saray",
