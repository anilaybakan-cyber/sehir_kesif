    {
      "id": "ChIJ__8buyv9ExMR1oSb5EZVJis",
      "name": "Arancino Tour Stop",
      "name_en": "Arancino Tour Stop",
      "category": "Deneyim",
      "tags": [
        "catania",
        "explore",
