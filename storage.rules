rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public read for app assets (city/route photos).
    // Write yalnızca konsol/Admin SDK üzerinden yapılır.
    match /cities/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /routes/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Diğer her şey kapalı (kullanıcı yüklemeleri vs eklenirse burası genişletilir).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
